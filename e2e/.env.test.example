# Copy file này thành e2e/.env.test (đã nằm trong .gitignore) rồi dùng nguyên văn —
# đây là DB test chạy trong Docker (docker-compose.test.yml), không chạm vào Neon dev/production.

DATABASE_URL="postgresql://fast_test:fast_test@localhost:5433/fast_test"
DIRECT_URL="postgresql://fast_test:fast_test@localhost:5433/fast_test"

AUTH_SECRET="e2e-test-secret-not-for-production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Fast"

# Rate limit: để trống -> lib/rate-limit.ts tự bỏ qua rate limit (xem lib/rate-limit.ts) nên không cần Upstash thật khi test.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email: để trống có chủ đích -> app/api/auth/register/route.ts bắt lỗi gửi email thất bại
# và TỰ ĐỘNG verify user luôn, nên test không cần đọc hộp mail thật để lấy token.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Fast <noreply@example.com>"

# Cloudinary: giá trị giả, vì Playwright sẽ intercept (page.route) mọi request upload ảnh trong test,
# không có request thật nào bay tới Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="test"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="test"
CLOUDINARY_API_KEY="test"
CLOUDINARY_API_SECRET="test"

NEXT_PUBLIC_PLATFORM_BANK_INFO="Test Bank - 0123456789 - NGUYEN VAN TEST"
NEXT_PUBLIC_PLATFORM_QR_URL=""

CRON_SECRET="e2e-test-cron-secret"

# Dùng bởi e2e/conftest.py — nơi app chạy (next start) trong lúc test.
PLAYWRIGHT_BASE_URL="http://localhost:3000"
